# Учебный курс, из которого вырос движок. Живёт только локально —
# история шагов лежит в несвязанной ветке steps-archive.
steps/

# Всё сгенерированное сборкой — вне истории: восстанавливается двумя командами.
build/
bin/

# Скомпилированные шейдеры: получаются из .vert/.frag одной командой сборки.
*.spv

# Путевой лист для clangd: симлинк на файл внутри build/.
compile_commands.json

# Индекс clangd.
.cache/

# Ассеты: бинарники в истории остаются навсегда и раздувают клон.
textures/
models/
